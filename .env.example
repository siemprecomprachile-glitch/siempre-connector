# ---------------------------------------------------------------------------
# SIEMPRE CONNECTOR - variables de entorno
# Copia este archivo a .env y completa los valores.
# ---------------------------------------------------------------------------

# URL publica donde corre este servicio (sin slash final).
# Mercado Libre envia los webhooks aca y hace el callback de OAuth.
PUBLIC_URL=https://connector.siemprecompra.cl

PORT=3000
NODE_ENV=production

# Clave para entrar al panel web (/panel). Invéntala, es solo tuya.
ADMIN_TOKEN=cambia-esto-por-algo-largo-y-random

# ---------------------------------------------------------------------------
# BSALE
# Token: panel Bsale -> Configuracion -> Integraciones -> Token API
# ---------------------------------------------------------------------------
BSALE_ACCESS_TOKEN=
BSALE_API_URL=https://api.bsale.io/v1

# Sucursal donde se emiten los documentos (Casa Matriz).
# Para ver los ids disponibles: npm run bsale:types
BSALE_OFFICE_ID=1

# Tipos de documento de TU cuenta Bsale. Correr `npm run bsale:types` y pegar
# los ids reales. codeSii 39 = boleta electronica, 33 = factura electronica.
BSALE_DOCTYPE_BOLETA_ID=
BSALE_DOCTYPE_FACTURA_ID=
BSALE_DOCTYPE_NOTA_CREDITO_ID=

# Forma de pago con la que se registra el documento (ej: "Mercado Pago").
# Ver ids: GET /v1/payment_types.json
BSALE_PAYMENT_TYPE_ID=

# Declarar al SII automaticamente (1 = si, 0 = deja el documento en borrador).
# ARRANCA EN 0 para probar sin emitir documentos reales. Cuando valides, pon 1.
BSALE_DECLARE_SII=0

# Id del impuesto IVA en Bsale (casi siempre 1).
BSALE_TAX_ID=1

# ---------------------------------------------------------------------------
# MERCADO LIBRE
# App creada en https://developers.mercadolibre.cl/devcenter
# Redirect URI a configurar en la app: {PUBLIC_URL}/oauth/mercadolibre/callback
# Topico a suscribir: orders_v2
# ---------------------------------------------------------------------------
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_SELLER_ID=

# ---------------------------------------------------------------------------
# CANALES OPCIONALES (dejalos vacios si Pivot todavia los cubre)
# ---------------------------------------------------------------------------
SHOPIFY_ENABLED=false
SHOPIFY_SHOP_DOMAIN=siemprecompra.myshopify.com
SHOPIFY_WEBHOOK_SECRET=

FALABELLA_ENABLED=false
FALABELLA_USER_ID=
FALABELLA_API_KEY=

# Paris / Marketplace Cencosud.
# API Key: seller center -> Mi Cuenta -> Integraciones (cuenta administrativa).
# El Seller ID lo devuelve la propia API al autenticarse; el de abajo es
# solo respaldo.
# Doc oficial: https://developers.ecomm.cencosud.com/docs
PARIS_ENABLED=false
PARIS_API_KEY=
PARIS_SELLER_ID=

# Produccion. Para el ambiente de pruebas, agregar "-stg":
# https://api-developers.ecomm-stg.cencosud.com
PARIS_API_URL=https://api-developers.ecomm.cencosud.com

# De que campo del item sale el precio con IVA: basePrice o priceAfterDiscounts.
PARIS_PRICE_FIELD=basePrice

# Subir el PDF del documento a Paris despues de emitirlo. Esto es lo que
# hace que el comprador reciba su boleta. Dejarlo en true.
PARIS_UPLOAD_INVOICE=true

# Lider / Walmart Chile Marketplace.
# Credenciales del developer portal de Walmart. El token dura 15 minutos
# y el conector lo renueva solo. Tampoco manda webhooks.
LIDER_ENABLED=false
LIDER_CLIENT_ID=
LIDER_CLIENT_SECRET=
LIDER_API_URL=https://marketplace.walmartapis.com

# Cada cuantos minutos se le pregunta a los canales sin webhook
# (Paris, Lider, Falabella).
SWEEP_INTERVAL_MINUTES=10

# ---------------------------------------------------------------------------
# REGLAS DE NEGOCIO
# ---------------------------------------------------------------------------
# Si el comprador entrega RUT de empresa -> factura. Si no -> boleta.
AUTO_FACTURA_ON_RUT=true

# Minutos de espera antes de facturar (deja margen para cancelaciones).
BILLING_DELAY_MINUTES=0

# Emitir solo cuando la orden esta pagada.
REQUIRE_PAID=true
